---
import Layout from "../layouts/Layout.astro";
import {getSiteSettings} from "../lib/content";

/* Vercel serves this for any unmatched path. Until now those hit the platform's own
   blank 404, which drops the visitor out of the site entirely — no header, no way back.
   The old Odoo URLs that are still indexed land here, so it needs to offer a route on. */
const settings = await getSiteSettings();

const LINKS = [
  {label: "Inicio", href: "/"},
  {label: "Nuestros servicios", href: "/servicios"},
  {label: "Muebles", href: "/muebles"},
  {label: "Automotriz", href: "/auto"},
  {label: "Blog", href: "/blog"},
  {label: "Solicitá tu presupuesto", href: "/contactus"},
];
---

<Layout
  title={`Página no encontrada | ${settings?.siteName ?? "LuxCuero"}`}
  description="La página que buscás no existe o cambió de dirección."
  transparentHeader={false}
>
  <section class="not-found">
    <div class="container">
      <p class="nf-code">404</p>
      <h1 class="nf-title">Esta página no existe</h1>
      <p class="nf-lead">
        Puede que el enlace esté desactualizado o que la página haya cambiado de dirección.
        Probá con una de estas secciones:
      </p>
      <ul class="nf-links">
        {
          LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* The header is solid on this route, so the section starts below it rather than
     under it. */
  .not-found {
    padding-top: 176px;
    padding-bottom: 96px;
    background-color: var(--color-ink);
    color: #fff;
    min-height: 60vh;
  }
  .nf-code {
    font-family: var(--font-heading);
    font-size: min(120px, calc(48px + 6vw));
    line-height: 1;
    color: var(--color-gold);
    margin-bottom: 8px;
  }
  .nf-title {
    font-size: min(50px, calc(26px + 2vw));
    color: #fff;
    margin-bottom: 16px;
  }
  .nf-lead {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.5;
    max-width: 620px;
    margin-bottom: 32px;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .nf-links a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--color-gold);
    border-radius: 160px;
    color: var(--color-gold);
    font-family: var(--font-btn);
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .nf-links a:hover {
    background-color: var(--color-gold);
    color: var(--color-ink);
  }
</style>
