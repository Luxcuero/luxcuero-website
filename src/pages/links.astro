---
// src/pages/links.astro
import Layout from '../layouts/Layout.astro';

const links = [
  {
    title: 'Nuestros trabajos',
    url: 'https://luxcuero.com',
  },
  {
    title: 'WhatsApp',
    url: 'https://api.whatsapp.com/send/?phone=5491165755153&text=Hola%2C+me+gustar%C3%ADa+recibir+m%C3%A1s+informaci%C3%B3n+sobre+sus+servicios+de+reparaci%C3%B3n+de+cuero&type=phone_number&app_absent=0',
  },
  {
    title: 'Instagram',
    url: 'https://instagram.com/lux.cuero',
  },
];
---

<Layout title="Luxcuero - Enlaces">
  <main class="min-h-screen bg-black flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden p-8 sm:p-12 text-center">
      <!-- Avatar -->
      <div class="mx-auto w-32 h-32 mb-6 rounded-full overflow-hidden border-4 border-[#d4af37] shadow-sm">
        <img
          src="/images/home/logo.webp"
          alt="Luxcuero Logo"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Title / Name -->
      <h1 class="text-3xl font-extrabold text-white mb-2 tracking-tight">Luxcuero</h1>
      
      <!-- Bio / Description -->
      <p class="text-lg text-zinc-400 mb-8 max-w-xs mx-auto">
        Tu cuero, como nuevo. ¿Para qué cambiás si podés restaurar?
      </p>

      <!-- Links -->
      <nav class="space-y-4">
        {links.map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-4 px-6 bg-[#d4af37] hover:bg-[#b5952f] text-black font-bold rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#d4af37]"
          >
            {link.title}
          </a>
        ))}
      </nav>

      <!-- Footer/Credits -->
      <div class="mt-12 text-sm text-zinc-500">
        <p>&copy; {new Date().getFullYear()} Luxcuero. Todos los derechos reservados.</p>
      </div>
    </div>
  </main>
</Layout>
