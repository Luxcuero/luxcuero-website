---
import CtaList from "../CtaList.astro";
import SanityImage from "../SanityImage.astro";
import {urlFor} from "../../lib/image";

interface Props {
  section: any;
}

const {section} = Astro.props;
const {
  variant = "page",
  eyebrow,
  kicker,
  headline,
  subheadline,
  body,
  checklist,
  backgroundImage,
  mediaImage,
  trustItems,
  ctas,
  wideContent,
} = section;

/* The banner lays its photo down as a CSS background rather than an <img>, so it needs a
   plain URL rather than the <SanityImage> element the other two variants use. */
const bannerBg = backgroundImage?.asset
  ? urlFor(backgroundImage).width(2400).auto("format").url()
  : null;

/* The source splits the subheadline across separate lines on /auto. */
const subLines: string[] = subheadline ? String(subheadline).split("\n") : [];
---

{
  variant === "home" && (
    <section
      id="hero"
      class="relative flex items-center min-h-[clamp(680px,70vh,820px)] pt-32 pb-0 md:pb-20 overflow-hidden"
    >
      <SanityImage
        image={backgroundImage}
        alt=""
        loading="eager"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105 blur-sm"
      />
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(135deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 6%, rgba(0,0,0,0.24) 90%, rgba(108,53,130,1) 100%);"
      />
      <div class="container relative z-10">
        <div class="w-full lg:w-2/3 text-white pl-4 md:pl-8">
          {kicker && (
            <h2 class="rfs-64 mb-2" style="color: var(--color-gold);">
              <span class="text-[20px] font-bold whitespace-normal lg:whitespace-nowrap">
                {kicker}
              </span>
            </h2>
          )}
          <h1 class="text-[34px] md:text-[42px] lg:text-[50px] font-normal mb-2 whitespace-normal lg:whitespace-nowrap">
            {headline}
          </h1>
          {subheadline && (
            <h2
              class="text-2xl md:text-3xl lg:text-[2.5rem] italic font-bold mb-6 whitespace-normal lg:whitespace-nowrap"
              style="color: var(--color-gold);"
            >
              {subheadline}
            </h2>
          )}
          {body && (
            <p class="italic text-base md:text-lg lg:text-xl text-white/90 mb-8 leading-relaxed max-w-3xl">{body}</p>
          )}
          <CtaList ctas={ctas} />
        </div>
      </div>
    </section>
  )
}

{
  variant === "page" && (
    <section class="relative flex items-center pt-[88px] pb-24 min-h-screen overflow-hidden">
      {/* Scaled up slightly so the blur's soft edges are cropped by the section instead
          of showing as a faded border. */}
      <SanityImage
        image={backgroundImage}
        alt=""
        loading="eager"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105 blur-[2px]"
      />
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.7) 50%, rgba(0,0,0,0.15) 100%);"
      />
      <div class="container relative z-10">
        <div class:list={["w-full text-white", wideContent ? "w-full" : "lg:w-3/4"]}>
          {/* An RFS-sized heading whose tall line box creates the gap below, with the
              visible text pinned to 18px inside it. */}
          {eyebrow && (
            <h2 class="rfs-40 mb-8" style="color: var(--color-gold);">
              <span class="text-[18px] font-bold">{eyebrow}</span>
            </h2>
          )}
          <h1 class="text-[50px] font-normal mb-2">{headline}</h1>
          {subLines.map((line, i) => (
            <h2
              class:list={[
                "text-[50px] italic font-bold",
                i === subLines.length - 1 ? "mb-8" : "mb-2",
              ]}
              style="color: var(--color-gold);"
            >
              {line}
            </h2>
          ))}
          {body && (
            <p class="text-[18px] font-light text-white leading-[1.5] mb-6">{body}</p>
          )}
          {checklist && checklist.length > 0 && (
            <ul class="mb-8">
              {checklist.map((item: string) => (
                <li class="flex items-center gap-2 mb-4 font-light text-white">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-gold)"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          )}
          <CtaList ctas={ctas} />
        </div>
      </div>
    </section>
  )
}

{
  variant === "banner" && (
    <section class="cu-banner" style={bannerBg ? `background-image: url('${bannerBg}');` : undefined}>
      <span class="cu-banner-filter" />
      <div class="container">
        <div class="cu-banner-grid">
          <div class="cu-banner-copy">
            {eyebrow && (
              <p class="cu-eyebrow">
                <b>{eyebrow}</b>
              </p>
            )}
            {/* The page's only top-level heading. It keeps the .cu-h2 class so it still
                draws at the banner's 32px, but the tag has to be <h1> — /contactus is the
                one page built on this variant and it was shipping without an h1 at all. */}
            <h1 class="cu-h2">
              <b>{headline}&nbsp;</b>
            </h1>
            {subheadline && (
              <h2 class="cu-h2">
                <b>
                  <span class="cu-gradient">{subheadline}</span>
                </b>
              </h2>
            )}
            <p>
              <br />
            </p>
            {body && <p>{body}</p>}
            {trustItems && trustItems.length > 0 && (
              <div class="cu-trust">
                {trustItems.map((badge: any) => (
                  <div class="cu-trust-col">
                    <p>
                      <SanityImage image={badge.icon} alt="" width={120} />
                    </p>
                    <p>{badge.label}</p>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="cu-banner-media">
            <SanityImage image={mediaImage} width={800} loading="eager" />
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* ── Banner ───────────────────────────────────────────────────────────────
     pt88 on the source; the extra 96px stands in for its static header. */
  .cu-banner {
    position: relative;
    padding-top: 184px;
    padding-bottom: 0;
    background-color: var(--color-ink);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #fff;
    overflow: hidden;
  }
  .cu-banner-filter {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      135deg,
      rgb(0, 0, 0) 0%,
      rgb(0, 0, 0) 6%,
      rgba(0, 0, 0, 0.24) 90%,
      rgb(108, 53, 130) 100%
    );
    pointer-events: none;
  }
  .cu-banner .container {
    position: relative;
    z-index: 1;
  }
  /* Stacked below lg, then the source's 12-column / 10-row grid takes over. */
  .cu-banner-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* Stacked, the source's grid items run to the container's edges. */
    margin-inline: -15px;
    padding-bottom: 48px;
  }
  @media (min-width: 992px) {
    .cu-banner-grid {
      margin-inline: 0;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(10, 50px);
      gap: 0;
      padding-bottom: 0;
    }
    .cu-banner-copy {
      grid-area: 1 / 7 / 9 / 13;
    }
    .cu-banner-media {
      grid-area: 1 / 1 / 11 / 7;
    }
  }
  /* Odoo insets its grid items by 10px. */
  .cu-banner-copy,
  .cu-banner-media {
    padding: 10px;
  }
  .cu-banner-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin-inline: auto;
  }
  .cu-banner p {
    margin-bottom: 16px;
  }
  .cu-eyebrow {
    color: var(--color-gold);
  }
  .cu-eyebrow b {
    font-weight: 700;
  }
  .cu-h2 {
    font-size: min(32px, calc(21.2px + 0.9vw));
    line-height: 1.2;
    color: #fff;
    margin-bottom: 8px;
  }
  .cu-h2 b {
    font-weight: 700;
  }
  /* The second line is painted with a gradient rather than a flat colour. */
  .cu-gradient {
    background-image: repeating-linear-gradient(
      135deg,
      rgb(255, 222, 69) 0%,
      rgb(69, 33, 0) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cu-trust {
    display: flex;
    flex-wrap: wrap;
    margin-inline: -15px;
  }
  .cu-trust-col {
    width: 33.333333%;
    padding-inline: 15px;
  }
  .cu-trust-col :global(img) {
    display: block;
    width: 31%;
    height: auto;
    margin-inline: auto;
  }
  /* Only the caption is centred on the source; the image centres via auto margins. */
  .cu-trust-col p + p {
    text-align: center;
  }
</style>
