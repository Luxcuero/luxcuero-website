---
import SanityImage from "../SanityImage.astro";
import {bandStyle} from "../../lib/bands";

interface Props {
  section: any;
}

const {section} = Astro.props;
const {heading, tagline, steps = [], background} = section;
---

<section class="py-16" style={bandStyle(background)}>
  <div class="container">
    {heading && <h2 class="text-3xl md:text-4xl mb-2">{heading}</h2>}
    {tagline && <p class="text-xl text-black/60 mb-12">{tagline}</p>}
    <div class="grid md:grid-cols-4 gap-6">
      {
        steps.map((step: any) => (
          <div class="text-center">
            <SanityImage image={step.icon} alt="" width={160} class="mx-auto block w-1/4 mb-4" />
            {step.illustration && (
              <SanityImage
                image={step.illustration}
                alt=""
                width={220}
                class="mx-auto block w-1/3 mb-4"
              />
            )}
            <p class="font-bold mb-2">{step.title}</p>
            <p class="text-black/60 leading-relaxed">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
