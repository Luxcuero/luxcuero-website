---
import SanityImage from "./SanityImage.astro";
import {dateShort} from "../lib/dates";

interface Props {
  heading: string;
  tagline: string;
  posts: any[];
  settings: any;
}

const {heading, tagline, posts, settings} = Astro.props;

const blog = settings?.blog ?? {};
---

<!-- Blog cover (source: o_wblog_post_page_cover, pt48 pb48). Top padding clears the
     fixed 96px header, which overlays this section transparently as on other pages. -->
<section class="blog-cover">
  <SanityImage image={blog.coverImage} alt="" width={2000} loading="eager" class="blog-cover-img" />
  <span class="blog-cover-filter"></span>
  <div class="container blog-cover-inner">
    <h1 class="text-white font-light" style="font-size: 56px; line-height: 1.2;">{heading}</h1>
    <p class="text-[18px] text-white mt-2">{tagline}</p>
  </div>
</section>

<!-- Search bar -->
<section class="blog-search" style="background-color: var(--color-ink);">
  <div class="container blog-search-inner">
    <form class="blog-search-form" role="search" action="/blog">
      <label class="sr-only" for="blog-search">{blog.searchLabel}</label>
      <input
        id="blog-search"
        name="search"
        type="search"
        placeholder={blog.searchPlaceholder}
        class="w-[236px] px-3 py-1.5 text-base outline-none"
        style="background-color: var(--color-cream); color: var(--color-body); border-radius: 6.4px 0 0 6.4px;"
      />
      <button
        type="submit"
        aria-label={blog.searchLabel}
        class="px-4 flex items-center justify-center"
        style="background-color: var(--color-cream); color: var(--color-body); border-radius: 0 6.4px 6.4px 0;"
      >
        <span class="fa fa-search"></span>
      </button>
    </form>
  </div>
</section>

<!-- Post grid (source: col-12 col-sm-6 col-lg-4 col-xl-3) -->
<section class="blog-list">
  <div class="container">
    {/* Declared in a scoped style block rather than with Tailwind breakpoint utilities,
        which kept the four-column rule from being generated in dev. */}
    <div class="post-grid">
      {
        posts.map((post) => (
          <div class="flex">
            <article class="w-full flex flex-col">
              {/* The gold background sits on the wrapper itself, so a post with no cover
                  occupies exactly the same box as one with an image. */}
              <a href={`/blog/${post.slug}`} class="post-cover group">
                <SanityImage image={post.cover} alt="" width={622} height={292} />
                {/* Gradient keeps the author legible over any cover. */}
                <span class="post-cover-scrim" />
                {post.author?.name && (
                  <span class="post-author">
                    <SanityImage image={post.author.avatar} alt="" width={38} height={38} />
                    {post.author.name}
                  </span>
                )}
              </a>

              <h2 class="rfs-22 leading-snug mt-3 line-clamp-3">
                <a href={`/blog/${post.slug}`} class="hover:underline">
                  {post.title}
                </a>
              </h2>

              <p class="mt-2 line-clamp-5">{post.excerpt}</p>

              {/* Pushes the tag row and date to the card's bottom so they line up across
                  the row. */}
              <div class="mt-auto pt-3">
                {post.tags && post.tags.length > 0 && (
                  <div class="post-tags">
                    {post.tags.map((tag: any) => (
                      <a href={`/blog/tag/${tag.slug}`} class="post-tag">
                        {tag.label}
                      </a>
                    ))}
                  </div>
                )}
                <p class="text-sm font-bold">{dateShort(post.publishedAt)}</p>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    {posts.length === 0 && <p class="text-center py-12">{blog.emptyState}</p>}
  </div>
</section>

<style>
  /* Cover band. Height comes from its own padding plus the 96px offset that clears the
     fixed header overlaying it, rather than a min-height, so it stays close to the
     source's compact 198px band. */
  .blog-cover {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-top: 136px;
    padding-bottom: 48px;
    background-color: var(--color-ink);
  }
  .blog-cover :global(.blog-cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* The source stacks a 90%-black layer at 40% opacity — an effective 36% black. */
  .blog-cover-filter {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.36);
  }
  .blog-cover-inner {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 767px) {
    .blog-cover {
      padding-top: 124px;
      padding-bottom: 36px;
    }
  }

  /* Tag pills, matching the source badges. */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }
  .post-tag {
    display: inline-block;
    max-width: 100%;
    padding: 4.2px 7.8px;
    margin-right: 4px;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    line-height: 12px;
    color: #626262;
    background-color: #f6f6f6;
    border: 1px solid #a2a2a2;
    border-radius: 800px;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .post-tag:hover {
    color: var(--color-ink);
    background-color: #ebebeb;
  }

  /* Breathing room between the dark search band and the first row of cards. */
  .blog-list {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
  @media (max-width: 767px) {
    .blog-list {
      padding-top: 2rem;
    }
  }

  /* Search sits hard right, as on the source. */
  .blog-search {
    padding-block: 1rem;
  }
  .blog-search-inner {
    display: flex;
    justify-content: flex-end;
  }
  .blog-search-form {
    display: flex;
  }

  /* One column on mobile, two on tablet, four across from the lg breakpoint (992px)
     used throughout the site. Equal columns, cards stretched to a shared height. */
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 1rem;
    row-gap: 2rem;
    align-items: stretch;
  }
  @media (min-width: 576px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 992px) {
    .post-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Fixed cover box, matching the source's 311x146. The gold background shows through
     for posts with no cover image, so both variants are exactly the same size. */
  .post-cover {
    position: relative;
    display: block;
    aspect-ratio: 311 / 146;
    border-radius: 6.4px;
    overflow: hidden;
    background-color: #e0a82e;
  }
  .post-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .post-cover:hover :global(img) {
    transform: scale(1.03);
  }
  .post-cover-scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 64px;
    background-image: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }

  /* Author badge, matching the source: 19px avatar, 16px label, 8px inset. */
  .post-author {
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    line-height: 1.2;
    color: #fff;
    z-index: 1;
  }
  .post-author :global(img) {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    border-radius: 9999px;
    object-fit: cover;
  }
</style>
