---
import {urlFor} from "../lib/image";

interface Props {
  image: any;
  /* Rendered width in CSS pixels. The URL is built at 2x for crisp output on retina. */
  width?: number;
  height?: number;
  alt?: string;
  class?: string;
  style?: string;
  loading?: "lazy" | "eager";
}

const {
  image,
  width,
  height,
  alt,
  class: className,
  style,
  loading = "lazy",
} = Astro.props;

/* Sections render optional images, so a missing one must collapse rather than throw —
   the Empresas card has no image until its source file is re-exported. */
const src = image?.asset
  ? (() => {
      let builder = urlFor(image).auto("format");
      if (width) builder = builder.width(width * 2);
      if (height) builder = builder.height(height * 2);
      if (width && height) builder = builder.fit("crop");
      return builder.url();
    })()
  : null;

/* Alt text lives on the image in Sanity; an explicit prop wins for cases where the
   caption supplies it (the before/after pair). */
const altText = alt ?? image?.alt ?? "";
---

{
  src && (
    <img
      src={src}
      alt={altText}
      class={className}
      style={style}
      loading={loading}
      width={width}
      height={height}
    />
  )
}
