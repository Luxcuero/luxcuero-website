# Sanity — both values are publishable and ship in the browser bundle, hence PUBLIC_.
# Copy this file to .env (which is gitignored).
PUBLIC_SANITY_PROJECT_ID=mwbr6shj
PUBLIC_SANITY_DATASET=production

# Google Analytics 4 Measurement ID, from Analytics > Admin > Data streams > web stream.
# The tag only renders in production builds, so leaving this unset locally is correct.
# It must ALSO be set in Vercel > Project > Settings > Environment Variables, otherwise
# the deployed site builds without analytics.
PUBLIC_GA_MEASUREMENT_ID=G-RVCP1QJNEF

# Search Console HTML-tag verification: the `content` value from
# Search Console > Settings > Ownership verification > HTML tag.
# Leave empty when ownership is verified by DNS instead — the tag is then unnecessary.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend, for the enquiry forms on /contactus and /soluciones. The key is server-side
# only — it is read by src/pages/api/contact.ts, which runs as a Vercel function, and
# never reaches the browser. Create it at resend.com > API keys with "sending" access.
# It must ALSO be set in Vercel > Project > Settings > Environment Variables; without it
# the endpoint returns a 500 and the form shows its failure message.
RESEND_API_KEY=

# Where enquiries are delivered, and who they come from. The From domain has to be
# verified in Resend (resend.com > Domains) or Resend refuses to send. Reply-To is set
# to the address the sender typed, so replying in the inbox reaches the customer.
CONTACT_TO=info@luxcuero.com
CONTACT_FROM=Luxcuero <no-reply@luxcuero.com>
